<link rel="stylesheet" href="{{ 'tryon-widget.css' | asset_url }}">

<div class="attyrenow-tryon" data-product-image="{{ block.settings.product.featured_image | image_url: width: 1024 }}">
  <button type="button" class="attyrenow-tryon__open-btn">
    {{ block.settings.button_text | default: "Try It On" }}
  </button>
  <p class="attyrenow-tryon__caption">See how this looks on you</p>

  <div class="attyrenow-tryon__panel" hidden>
    <div class="attyrenow-tryon__body">
      <div class="attyrenow-tryon__header">
        <div>
          <span class="attyrenow-tryon__title">Try It On</span>
          <p class="attyrenow-tryon__subtitle">See how this looks on you in a few seconds.</p>
        </div>
        <button type="button" class="attyrenow-tryon__close-btn" aria-label="Close">&times;</button>
      </div>

      <div class="attyrenow-tryon__choices">
        <label class="attyrenow-tryon__choice">
          <input type="file" accept="image/*" class="attyrenow-tryon__file-input" hidden>
          <span class="attyrenow-tryon__choice-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 16V4"/><path d="m7 9 5-5 5 5"/><path d="M4 16v3a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-3"/></svg>
          </span>
          <span class="attyrenow-tryon__choice-title">Upload a photo</span>
          <span class="attyrenow-tryon__choice-desc">Pick one from your gallery or files</span>
        </label>

        <button type="button" class="attyrenow-tryon__choice attyrenow-tryon__camera-btn">
          <span class="attyrenow-tryon__choice-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 4h-5L8 6H5a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-3z"/><circle cx="12" cy="13" r="3.5"/></svg>
          </span>
          <span class="attyrenow-tryon__choice-title">Take a photo</span>
          <span class="attyrenow-tryon__choice-desc">Use your camera with a countdown timer</span>
        </button>
      </div>

      <ul class="attyrenow-tryon__requirements">
        <li>✓ Full body</li>
        <li>✓ Good lighting</li>
        <li>✓ Just you</li>
        <li>✓ Fitted clothes</li>
      </ul>

      <div class="attyrenow-tryon__preview" hidden>
        <img class="attyrenow-tryon__preview-img" alt="Your photo" width="380" height="320">
        <button type="button" class="attyrenow-tryon__change-btn">Change photo</button>
      </div>

      <button type="button" class="attyrenow-tryon__generate-btn" disabled>
        <span class="attyrenow-tryon__generate-icon">✨</span>
        Try It On Now
      </button>

      <p class="attyrenow-tryon__lock-note">🔒 Images never stored · AI preview only</p>

      <div class="attyrenow-tryon__result" hidden>
        <img class="attyrenow-tryon__result-img" alt="Try-on result" width="380" height="320">
      </div>

      <p class="attyrenow-tryon__status"></p>
    </div>
  </div>
</div>

<script src="{{ 'tryon-widget.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "AttyreNow Try-On",
  "target": "section",
  "settings": [
    { "type": "product", "id": "product", "label": "Product", "autofill": true },
    { "type": "text", "id": "button_text", "label": "Button text", "default": "Try It On" }
  ]
}
{% endschema %}